<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#347FE5</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#347FE5</item>
        <item name="android:navigationBarColor">#101311</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#347FE5</item>
    </style>
</resources>
